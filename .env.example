# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

# JWT secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

# Upstash Redis (https://console.upstash.com -> your database -> REST API)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email (Gmail SMTP). GMAIL_PASS must be a Google App Password, not your login password.
GMAIL_USER="you@gmail.com"
GMAIL_PASS=""
SMTP_USER="you@gmail.com"

# Base URL used in invite / reset-password links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
