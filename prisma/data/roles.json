[
  {
    "name": "ADMIN",
    "description": "Administrator with full access",
    "permissions": "all"
  },
  {
    "name": "MODERATOR",
    "description": "Moderator with elevated permissions",
    "permissions": {
      "modules": ["category", "inventory", "supplier", "purchase"],
      "extra": [
        { "module": "dashboard", "action": "read" },
        { "module": "reports", "action": "read" },
        { "module": "access-management", "action": "read", "submodule": "users" },
        { "module": "access-management", "action": "read", "submodule": "roles" }
      ]
    }
  },
  {
    "name": "INVENTORY_CLERK",
    "description": "Manages stock and drafts purchases; can't receive, cancel or delete them",
    "permissions": {
      "modules": ["inventory"],
      "extra": [
        { "module": "dashboard", "action": "read" },
        { "module": "category", "action": "read" },
        { "module": "supplier", "action": "read" },
        { "module": "purchase", "action": "read" },
        { "module": "purchase", "action": "create" }
      ]
    }
  },
  {
    "name": "USER",
    "description": "Regular user with basic access",
    "permissions": "read_only"
  }
]
